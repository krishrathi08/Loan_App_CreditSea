PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/creditsea
JWT_SECRET=change_me
# Use mock locally, or msg91 after configuring a MSG91 OTP template and credentials
OTP_PROVIDER=mock
EXPOSE_OTP=true
# Required when OTP_PROVIDER=msg91; keep these values private
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91
ADMIN_KEY=admin123
# Optional: Firebase service-account JSON (keep the credential private)
FIREBASE_SERVICE_ACCOUNT=
